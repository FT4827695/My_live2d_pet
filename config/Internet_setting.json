{
    "web_search_enabled": true,
    "proxy": "",
    "request_timeout_sec": 15,
    "max_results_per_source": 3,
    "cache_ttl_sec": 600,
    "max_snippet_chars": 2048,
    "max_article_chars": 4096,
    "tavily_enabled": true,
    "tavily_fallback_to_general": true,
    "search_apis": [
        {
            "id": "api_1",
            "display_name": "API 1",
            "protocol": "tavily",
            "api_base": "https://api.tavily.com",
            "api_key_enc": "",
            "enabled": true,
            "request": {},
            "response": {}
        },
        {
            "id": "api_2",
            "display_name": "API 2",
            "protocol": "generic_http",
            "api_base": "https://api.deepseek.com/v1/tools/search",
            "api_key_enc": "",
            "enabled": false,
            "request": {
                "method": "POST",
                "url": "{api_base}",
                "auth": {
                    "type": "bearer"
                },
                "json": {
                    "query": "{query}",
                    "count": "{max_results}"
                }
            },
            "response": {
                "results_path": "results",
                "title": "title",
                "url": "url",
                "snippet": [
                    "snippet",
                    "summary",
                    "content"
                ]
            }
        },
        {
            "id": "api_3",
            "display_name": "API 3",
            "protocol": "generic_http",
            "api_base": "https://qianfan.baidubce.com/v2/ai_search/web_summary",
            "api_key_enc": "",
            "enabled": false,
            "request": {
                "method": "POST",
                "url": "{api_base}",
                "auth": {
                    "type": "bearer"
                },
                "json": {
                    "messages": [
                        {
                            "role": "user",
                            "content": "{query}"
                        }
                    ],
                    "resource_type_filter": {
                        "web": [
                            {
                                "top_k": "{max_results}"
                            }
                        ]
                    }
                }
            },
            "response": {
                "results_path": [
                    "references",
                    "search_results",
                    "data"
                ],
                "title": "title",
                "url": "url",
                "snippet": [
                    "content",
                    "snippet",
                    "summary"
                ]
            }
        }
    ],
    "sources": [
        {
            "id": "bing_news",
            "type": "news_search",
            "enabled": true,
            "display_name": "Bing新闻"
        },
        {
            "id": "baidu",
            "type": "baidu_search",
            "enabled": true,
            "display_name": "百度",
            "target_domain": "www.baidu.com",
            "no_body": false
        },
        {
            "id": "sogou",
            "type": "sogou_search",
            "enabled": true,
            "display_name": "搜狗",
            "target_domain": "www.sogou.com",
            "no_body": false
        }
    ]
}